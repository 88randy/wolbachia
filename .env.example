# Optional local Compose overrides. Defaults keep the API on loopback only.
# See backend/README.md: "Testing with a phone on the LAN".
# Use only on a trusted network; replace 192.168.1.50 with the PC's LAN IPv4 address.
# API_BIND=0.0.0.0
# DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,[::1],192.168.1.50
