# Copy to backend/.env for local runs outside Docker (`.env` is git-ignored; never commit it).
# docker compose (backend/compose.yaml) sets its own dev values and does not need this file.
# Real environment variables always win over this file.

# --- Required in every environment ---------------------------------------------------------
# The settings module is NOT chosen here: this file is read after it is picked. Use a real
# environment variable or `--settings` (manage.py defaults to dev; pytest uses test; wsgi, asgi
# and celery default to prod).
# Secret key (dev and prod). Generate a long random value per environment; never reuse it.
DJANGO_SECRET_KEY=change-me
# PostgreSQL URL (use 127.0.0.1, not localhost: on Windows localhost tries IPv6 first and is slow).
# Managed clusters (DigitalOcean) need TLS: append ?sslmode=require
DATABASE_URL=postgres://wolbachia:wolbachia@127.0.0.1:5432/wolbachia
# Redis URL: cache (throttling) and Celery broker. docker compose publishes Redis on
# 127.0.0.1:${REDIS_PORT:-6379}. In dev a Redis outage makes throttled requests fail with 500.
REDIS_URL=redis://127.0.0.1:6379/0

# --- Production only (config.settings.prod) ------------------------------------------------
# Comma-separated host names served by this deployment.
# DJANGO_ALLOWED_HOSTS=api.example.com
# Comma-separated origins (with scheme) allowed to send CSRF-protected requests.
# DJANGO_CSRF_TRUSTED_ORIGINS=https://app.example.com
# Redirect HTTP to HTTPS (default true).
# DJANGO_SECURE_SSL_REDIRECT=true
# Trust X-Forwarded-Proto from the reverse proxy (default false). Enable only behind a proxy
# that sets and sanitizes it, otherwise the HTTPS redirect loops.
# DJANGO_TRUST_PROXY_SSL_HEADER=false

# --- Optional (defaults shown) -------------------------------------------------------------
# Page-number pagination size (max 200 via ?page_size=).
# API_PAGE_SIZE=50
# Cursor pagination size.
# API_CURSOR_PAGE_SIZE=100
# DRF throttle rates: anonymous (per IP) and authenticated (per user).
# THROTTLE_ANON_RATE=60/min
# THROTTLE_USER_RATE=600/min
# Trusted reverse proxies in front of the API (default 0 = ignore X-Forwarded-For, so rotating
# that header cannot evade throttling). REQUIRED in production (no default): set it to the real
# proxy count. The TLS proxy must overwrite X-Forwarded-For and the app servers must never be
# reachable directly.
# DRF_NUM_PROXIES=0
# LOG_LEVEL=INFO

# --- Authentication (#4), optional unless noted (defaults shown) ---------------------------
# Access token lifetime (seconds) and refresh token idle lifetime (days; slides on each refresh).
# AUTH_ACCESS_TOKEN_TTL_SECONDS=900
# AUTH_REFRESH_TOKEN_TTL_DAYS=30
# An old refresh token still rotates inside this window (lost responses); after it, the session
# is revoked as refresh_reuse.
# AUTH_REFRESH_REUSE_GRACE_SECONDS=60
# Hours a phone keeps for one final upload when an admin revokes it with allow_final_upload;
# 0 disables it.
# AUTH_REVOKED_FINAL_UPLOAD_HOURS=72
# Failed logins per username+address that lock the pair, and for how long.
# AUTH_LOGIN_MAX_FAILURES=5
# AUTH_LOGIN_LOCKOUT_MINUTES=15
# Web session cookie age (seconds) and password reset link lifetime (seconds).
# AUTH_WEB_SESSION_AGE_SECONDS=43200
# PASSWORD_RESET_TIMEOUT=3600
# Reset emails sent to one address per hour (anyone who knows an address can use its quota).
# AUTH_PASSWORD_RESET_EMAILS_PER_ADDRESS_PER_HOUR=3
# Rate limits (DRF format) of the public auth endpoints.
# THROTTLE_LOGIN_USER_IP_RATE=10/min
# THROTTLE_LOGIN_IP_RATE=30/min
# THROTTLE_REFRESH_RATE=30/min
# THROTTLE_PASSWORD_RESET_RATE=5/hour
# THROTTLE_PASSWORD_RESET_CONFIRM_RATE=20/hour
# Password reset email. EMAIL_URL is a django-environ URL: consolemail:// (prints the message,
# default in dev), smtp://user:pass@host:587 (smtps:// and smtp+tls:// use TLS), memorymail://.
# REQUIRED in production together with DEFAULT_FROM_EMAIL and WEB_BASE_URL (https only there).
# EMAIL_URL=consolemail://
# DEFAULT_FROM_EMAIL=Wolbachia <no-reply@example.com>
# WEB_BASE_URL=http://localhost:5173
# WEB route that receives the reset link as <path>/<uid>/<token>.
# WEB_PASSWORD_RESET_PATH=/reset-password
# Read backend/.env: true by default, false by default in config.settings.prod.
# DJANGO_READ_DOT_ENV_FILE=true
