  "dependencies": {
    "openapi-fetch": "0.17.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "openapi-typescript": "7.13.0"
  },
  "engines": {
    "node": ">=22.13"
  }
}
