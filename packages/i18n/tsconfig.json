{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    // Node runs the .ts files directly (--experimental-strip-types): imports keep the .ts
    // extension and only erasable syntax (no enums or namespaces) is allowed.
    "allowImportingTsExtensions": true,
    "erasableSyntaxOnly": true,
    "types": ["node"]
  },
  "include": ["src", "test"]
}
