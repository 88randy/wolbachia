{
  "name": "@wolbachia/tokens",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Codequim design tokens (light and dark themes) shared by mobile and web.",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./tokens.css": "./dist/tokens.css"
  },
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "build:css": "node --experimental-strip-types scripts/build-css.ts",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --test \"test/**/*.test.ts\""
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "typescript": "^7.0.2"
  },
  "engines": {
    "node": ">=22.13"
  }
}
