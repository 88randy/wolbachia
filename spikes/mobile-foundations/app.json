{
  "expo": {
    "name": "Foundations Spike",
    "slug": "mobile-foundations",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "android": {
      "package": "mx.pyrobyte.spikes.foundations",
      "versionCode": 1,
      "permissions": [
        "android.permission.CAMERA",
        "android.permission.REQUEST_INSTALL_PACKAGES"
      ],
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ],
      "@maplibre/maplibre-react-native",
      "expo-location",
      "./plugins/with-lock-task-mode",
      ["./plugins/with-package-queries", { "packages": ["app.organicmaps"], "intentSchemes": ["geo"] }],
      [
        "./plugins/with-library-build-config",
        {
          "projects": ["nozbe_watermelondb"]
        }
      ]
    ]
  }
}
