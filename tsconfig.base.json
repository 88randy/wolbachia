{
  // Shared compiler options. Every workspace tsconfig.json extends this file and only
  // adds what is specific to it (jsx, lib, include, references).
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "lib": ["ES2022"],
    "noEmit": true,
    "skipLibCheck": true,
    "isolatedModules": true,
    "verbatimModuleSyntax": true,
    "forceConsistentCasingInFileNames": true,

    "strict": true,
    "noUncheckedIndexedAccess": true,
    "noImplicitOverride": true,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true
    // exactOptionalPropertyTypes is deliberately OFF here: it makes `prop?: T` reject an
    // explicit `undefined`, which many React / React Native / third-party typings still pass.
    // A package that does not fight those types may turn it on in its own tsconfig.json.
  }
}
