# Copy to web/.env for local development (web/.env is not committed).
# Base URL of the backend API. Required: the app shows a configuration error without it.
# Vite reads VITE_* at BUILD time and writes it into the public bundle: never put secrets here.
# An absolute URL (https://api.example.com/api/v1) or a same-origin path (/api/v1).
VITE_API_BASE_URL=/api/v1
