{
  "extends": "../tsconfig.base.json",
  "compilerOptions": {
    "jsx": "react-jsx",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    // The shared packages are TypeScript sources whose internal imports keep the .ts extension
    // (Node runs them directly), so the web compiler must accept that too.
    "allowImportingTsExtensions": true,
    "types": ["vite/client", "node"],
    "paths": { "@/*": ["./src/*"] }
  },
  "include": ["src", "e2e", "harness", "*.config.ts"]
}
